# Copy to .env and set a random 32-byte key (64 hex characters).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BROKENGPT_ENCRYPTION_KEY=
NODE_ENV=development
PORT=3000
TRUST_PROXY=0

# Owner access: set these only in the private hosting environment, never in GitHub.
# Register the owner account first, then set its SQLite users.id as OWNER_USER_ID.
BROKENGPT_OWNER_USER_ID=
BROKENGPT_OWNER_EMAIL=
# Resend email delivery: use a verified sender address on your Resend account.
RESEND_API_KEY=
BROKENGPT_EMAIL_FROM=

# Optional: require HTTP Basic Auth before serving the private demo.
# Set a long, random value in the hosting provider's private environment settings.
BROKENGPT_DEMO_ACCESS_PASSWORD=
