# Copy to .env and set a random 32-byte key (64 hex characters).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BROKENGPT_ENCRYPTION_KEY=
NODE_ENV=development
PORT=3000
TRUST_PROXY=0

# Exact browser/app origins allowed to call this backend (comma-separated).
# Include your deployed website origin and Capacitor origins when needed.
CORS_ORIGINS=https://localhost,capacitor://localhost,http://localhost
